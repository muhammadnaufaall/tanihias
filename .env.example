# Copy this file to .env.local and fill it in from the Supabase dashboard.
# .env.local is not committed to git.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings → API Keys → Publishable key (sb_publishable_...)
# Safe to use in the browser; data access is still restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Only for running migrations through the CLI (not used by the app).
# Connect button → choose "Session pooler" (not "Direct connection", which is
# IPv6-only and usually fails from home networks) → copy the URI as is, then
# replace [YOUR-PASSWORD]. Keep the host (aws-0/aws-1) and region as given.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
